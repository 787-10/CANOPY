{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canopy.local/schemas/anomaly.schema.json",
  "title": "CANOPY Anomaly",
  "description": "Derived anomaly emitted by fusion services after reading canonical Signals.",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "ts", "kind", "source_signal", "severity", "payload"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "time": {"type": "number"},
    "ts": {"type": "string", "format": "date-time"},
    "marking": {
      "type": "string",
      "pattern": "^(U|CUI|CUI//SP-[A-Z0-9][A-Z0-9-]*(/SP-[A-Z0-9][A-Z0-9-]*)*)$",
      "default": "U",
      "description": "Marking (docs/INTERFACE-SPEC.md 1.1): U, CUI or CUI//SP-<CATEGORY>[/SP-<CATEGORY>...]. Optional so files recorded before spec 1.4 stay valid; the engine always emits it, U by default."
    },
    "kind": {"type": "string", "minLength": 1},
    "source_signal": {"type": "string", "minLength": 1},
    "source_signal_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "severity": {"type": "number", "minimum": 0, "maximum": 1},
    "payload": {"type": "object"}
  }
}
