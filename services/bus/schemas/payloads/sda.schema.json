{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canopy.local/schemas/payloads/sda.schema.json",
  "title": "SDA Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_id",
    "event_type",
    "track_quality",
    "summary"
  ],
  "properties": {
    "object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "catalog_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "object_type": {
      "type": "string",
      "enum": [
        "satellite",
        "debris",
        "rocket_body",
        "unknown"
      ]
    },
    "event_type": {
      "type": "string",
      "enum": [
        "conjunction",
        "maneuver",
        "breakup",
        "proximity",
        "track_update"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "range_km": {
      "type": "number",
      "minimum": 0
    },
    "relative_velocity_mps": {
      "type": "number",
      "minimum": 0
    },
    "track_quality": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "candidate_satellite_ids": {
      "description": "Closely-spaced objects: the flight identities a cue is consistent with when it cannot be resolved to one satellite_id (INTERFACE-SPEC 5.4). Null or absent when the cue is resolved.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "pattern": "^ctb://[a-z0-9.-]+/[a-z0-9-]+(?:/component/[a-z0-9-]+)?$"
      }
    }
  }
}
