{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canopy.local/schemas/payloads/drone.schema.json",
  "title": "Drone Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "track_id",
    "platform_type",
    "activity",
    "event_type",
    "summary"
  ],
  "properties": {
    "track_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "platform_type": {
      "type": "string",
      "enum": [
        "fixed_wing",
        "rotary",
        "multirotor",
        "loitering_munition",
        "unknown"
      ]
    },
    "activity": {
      "type": "string",
      "enum": [
        "launch",
        "landing",
        "transit",
        "loiter",
        "payload_release",
        "lost_link"
      ]
    },
    "event_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "altitude_m": {
      "type": "number",
      "minimum": 0
    },
    "speed_mps": {
      "type": "number",
      "minimum": 0
    },
    "heading_deg": {
      "type": "number",
      "minimum": 0,
      "maximum": 360
    },
    "operator_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "candidate_satellite_ids": {
      "description": "Closely-spaced objects: the flight identities a cue is consistent with when it cannot be resolved to one satellite_id (INTERFACE-SPEC 5.4). Null or absent when the cue is resolved.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "pattern": "^ctb://[a-z0-9.-]+/[a-z0-9-]+(?:/component/[a-z0-9-]+)?$"
      }
    }
  }
}
